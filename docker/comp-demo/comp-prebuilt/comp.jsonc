// Descriptor for registering this project's build output as one new component
// version (pattern 2: upload prebuilt). Steps:
//   pnpm install --ignore-workspace
//   pnpm run build       -> dist/
//   pnpm run register    -> uploads dist/ as outputFileList
// --ignore-workspace matters when this folder sits inside an enclosing pnpm
// workspace: a react copy hoisted by that workspace must not leak into the
// build, or hosts running another react version fail to render the component.
{
  "service": { "urlRegistry": "http://127.0.0.1:9415" },

  "compName": "hello-components",

  // federation and exposeList must stay consistent with vite.config.js
  "metadata": {
    "schemaVersion": 1,
    "versionName": "0.0.1",
    "description": "sample remote entry with a card and a badge, built locally",
    "exposeDefaultName": "hello-card",
    "federation": {
      "containerName": "helloCardApp",
      "fileEntry": "HelloCard.js"
    },
    "exposeList": [
      {
        "exposeName": "hello-card",
        "description": "card with a title and body text",
        "modulePath": "./hello-components",
        "fileEntrySource": "src/entry.jsx",
        "entryExport": "default",
        "props": {
          "data": { "type": "object", "description": "title and text to render" }
        },
        "packages": {
          "react": { "versionRequired": "^19.2.0", "isShared": true },
          "react-dom": { "versionRequired": "^19.2.0", "isShared": true }
        }
      },
      {
        "exposeName": "hello-badge",
        "description": "small status badge",
        "modulePath": "./hello-components",
        "fileEntrySource": "src/entry.jsx",
        "entryExport": "HelloBadge",
        "props": {
          "text": { "type": "string", "description": "badge text" },
          "tone": { "type": "string", "description": "info or success; optional" }
        },
        "packages": {
          "react": { "versionRequired": "^19.2.0", "isShared": true },
          "react-dom": { "versionRequired": "^19.2.0", "isShared": true }
        }
      }
    ]
  },

  // pattern 2: files under this folder are registered as outputFileList,
  // with paths relative to the folder itself
  "output": { "dir": "dist" }
}
